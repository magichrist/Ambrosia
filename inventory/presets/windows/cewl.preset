name: CeWL
description: Generate wordlist from website using CeWL.
tags:
  - wordlist
  - cewl
  - generation
  - osint
shell: "cewl {{url}} -w {{wordlist}}"
inputs:
  - id: url
    prompt: "Target URL"
    type: string
    required: true
    secret: false
    validation_hint: "URL of the website to spider"
  - id: wordlist
    prompt: "Output wordlist path"
    type: path
    required: true
    secret: false
    validation_hint: "path to save the generated wordlist"
