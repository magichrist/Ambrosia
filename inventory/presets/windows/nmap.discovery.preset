name: Nmap Service Discovery
description: Bounded Nmap service discovery on target (read-only).
tags:
  - windows
  - discovery
  - read-only
  - nmap
  - builtin
shell: "nmap -sV {{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "must be an IP address or hostname within scope"
