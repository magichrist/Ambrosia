name: RDP No NLA
description: RDP connection without Network Level Authentication.
tags: [windows, rdp, rdesktop, execution]
shell: "rdesktop -r '' {{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "must be an IP address or hostname within scope"
