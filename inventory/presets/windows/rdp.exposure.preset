name: RDP Exposure Observation
description: Check RDP port (3389) exposure on target (read-only).
tags: [windows, rdp, read-only, builtin]
shell: "nmap -p 3389 {{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "must be an IP address or hostname within scope"
