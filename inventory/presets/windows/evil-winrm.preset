name: Evil-WinRM
description: Connect via Evil-WinRM using NTLM hash.
tags:
  - windows
  - winrm
  - evil-winrm
  - execution
  - hash
shell: "evil-winrm -i {{target}} -u {{username}} -H {{hash}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "must be an IP address or hostname within scope"
  - id: username
    prompt: "Username"
    type: string
    required: true
    secret: false
    validation_hint: "authenticated username"
  - id: hash
    prompt: "NTLM hash"
    type: secret
    required: true
    secret: true
    validation_hint: "NTLM hash of the user"
