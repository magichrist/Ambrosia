name: CrackMapExec SMB
description: Enumerate SMB on target (read-only).
tags: [windows, smb, crackmapexec, enumeration, read-only]
shell: "crackmapexec smb {{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "must be an IP address or hostname within scope"
