name: Impacket SecretsDump Local
description: Dump secrets from local SAM and SYSTEM files.
tags:
  - windows
  - impacket
  - secretsdump
  - credentials
shell: "impacket-secretsdump -sam {{sam}} -system {{system}} local"
inputs:
  - id: sam
    prompt: "Path to SAM file"
    type: path
    required: true
    secret: false
    validation_hint: "path to the SAM registry hive"
  - id: system
    prompt: "Path to SYSTEM file"
    type: path
    required: true
    secret: false
    validation_hint: "path to the SYSTEM registry hive"
