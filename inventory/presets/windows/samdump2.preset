name: SAMDump2
description: Extract password hashes from SAM and SYSTEM files.
tags: [windows, samdump2, credentials, dump]
shell: "samdump2 {{system}} {{sam}}"
inputs:
  - id: system
    prompt: "Path to SYSTEM file"
    type: path
    required: true
    secret: false
    validation_hint: "path to the SYSTEM registry hive"
  - id: sam
    prompt: "Path to SAM file"
    type: path
    required: true
    secret: false
    validation_hint: "path to the SAM registry hive"
