name: Hydra MSSQL
description: Brute-force MSSQL login with Hydra.
tags:
  - linux
  - hydra
  - mssql
  - brute-force
shell: "hydra -l {{username}} -P {{passlist}} mssql://{{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "MSSQL server IP or hostname"
  - id: username
    prompt: "Username"
    type: string
    required: true
    secret: false
    validation_hint: "username to attempt"
  - id: passlist
    prompt: "Path to password list"
    type: path
    required: true
    secret: false
    validation_hint: "path to the password wordlist"
