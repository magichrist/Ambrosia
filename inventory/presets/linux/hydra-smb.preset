name: Hydra SMB
description: Brute-force SMB login with Hydra.
tags:
  - linux
  - hydra
  - smb
  - brute-force
shell: "hydra -L {{userlist}} -P {{passlist}} smb://{{target}}"
inputs:
  - id: target
    prompt: "Target IP or hostname"
    type: host
    required: true
    secret: false
    validation_hint: "SMB server IP or hostname"
  - id: userlist
    prompt: "Path to username list"
    type: path
    required: true
    secret: false
    validation_hint: "path to the username wordlist"
  - id: passlist
    prompt: "Path to password list"
    type: path
    required: true
    secret: false
    validation_hint: "path to the password wordlist"
